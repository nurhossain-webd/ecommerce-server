

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}
model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]
  orders    Order[]

  @@map("users")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @unique
  status    CategoryStatus @default(ACTIVE)
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  products  Product[]
  @@map("categories")
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  INACTIVE
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Float
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  isDeleted   Boolean       @default(false)

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("products")
}
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  rating    Int
  comment   String?
  isDeleted Boolean  @default(false)

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])

  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@map("reviews")
}
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  status     OrderStatus @default(PENDING)
  totalPrice Float
  isDeleted  Boolean     @default(false)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid()) @db.Uuid
  quantity Int
  price    Float

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}